# Local development only — never commit a filled-in copy.
# The cluster gets these from the Helm chart's ConfigMap and Secrets.
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=local-dev-only
ADMIN_JWT_SECRET=local-dev-only
TRANSFER_TOKEN_SALT=local-dev-only
JWT_SECRET=local-dev-only
ENCRYPTION_KEY=local-dev-only

DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

UPLOAD_PROVIDER=local
